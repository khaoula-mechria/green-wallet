# Frontend environment configuration

# API mode: "mock" (default, browser-only) or "real" (calls backend)
# Phase 0: Set to "real" to use actual ledger transactions instead of simulated data
VITE_API_MODE=mock

# Backend API base URL (when VITE_API_MODE=real)
# Default: /api (proxied through Vite dev server or production server)
# For real deployment, adjust to your backend URL
VITE_API_URL=/api
