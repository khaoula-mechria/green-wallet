# Copy to .env and adjust. None of these are required to run the app locally
# — with nothing set below, the backend boots in development mode with local/
# simulated blockchain, demo data, the simulation and a demo JWT secret.
#
# With NODE_ENV=production the backend REFUSES TO START unless JWT_SECRET and
# KEY_ENCRYPTION_SECRET are real secrets (>= 32 chars, distinct, not the
# placeholders below) and CORS_ORIGIN is not '*'. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=4000
# Unset: '*' in development, same-origin only in production.
# Otherwise '*' (development only) or a comma-separated list of origins.
CORS_ORIGIN=

# Path to the SQLite database file (created automatically).
DB_PATH=./data/green-wallet.db

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
KEY_ENCRYPTION_SECRET=replace-with-a-long-random-string

# --- Demo features (default: on in development, off in production) ----------
# Seed the demo microgrid (2 producers, 5 prosumers, 4 consumers, password
# `password123`) into an empty DB.
SEED_DEMO_DATA=
# Record a simulated meter reading per household every market interval.
SIMULATION_ENABLED=

# --- Market clock (docs/DESIGN.md §0.6) --------------------------------------
# One auction per interval. 5000 ms x 30 simulated minutes = a day in 4 minutes.
# Unset: falls back to SIMULATION_TICK_MS / SIMULATION_MINUTES_PER_TICK.
MARKET_INTERVAL_MS=5000
MARKET_INTERVAL_SIM_MINUTES=30

# --- Manual meter readings ---------------------------------------------------
# Self-reported production earns green certificates, so readings are untrusted:
# disabled by default in production, and always capped and rate-limited.
MANUAL_MEASUREMENTS_ENABLED=
MEASUREMENT_MAX_KWH=50
MEASUREMENT_MIN_INTERVAL_MS=60000

# --- Money and ledger (§7) -----------------------------------------------------
TREASURY_INITIAL_TEC=10000
TREASURY_LOW_WARNING_TEC=1000
GRID_STORAGE_INITIAL_TEC=500
# Paid by the treasury to new prosumers and consumers (not producers).
WELCOME_GRANT_TEC=10
# Simulated top-up / cash-out: on in development, off in production.
TOPUPS_ENABLED=
TOPUP_MAX_TEC=100
TOPUP_COOLDOWN_MS=10000
SIMULATED_FEE_HBAR=0.0001

# --- The utility's prices (§3.1) ---------------------------------------------
# ceiling (import) = wholesale + network + taxes + margin = 0.30 TEC/kWh
# floor (export)   = wholesale - balancing               = 0.05 TEC/kWh
WHOLESALE_PRICE_TEC=0.08
NETWORK_FEE_TEC=0.09
TAXES_TEC=0.08
SUPPLIER_MARGIN_TEC=0.05
UTILITY_BALANCING_COST_TEC=0.03

# --- Batteries and the shared battery (§1, §6, §8) ----------------------------
HOUSEHOLD_DEFAULT_BATTERY_CAPACITY_KWH=10
HOUSEHOLD_MAX_BATTERY_CAPACITY_KWH=50
SHARED_BATTERY_CAPACITY_KWH=100
SHARED_BATTERY_RENTED_SHARE=0.6
RENTED_CAP_PER_HOUSEHOLD_KWH=10
STORAGE_DECAY_PER_SIM_HOUR=0.01
GRID_POOL_INITIAL_SHARE=0.5
GRID_POOL_BUY_BELOW_AVG=0.9
GRID_POOL_SELL_ABOVE_AVG=1.1
OFFER_EXPIRY_SIM_HOURS=24

# --- Hedera ------------------------------------------------------------------
# The app runs on a simulated Hedera-style ledger (local mode only). Real
# Hedera is future work: if these are set, the server logs a warning and
# ignores them.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOKEN_ID=
