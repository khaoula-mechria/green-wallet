# Copy to .env and adjust. None of these are required to run the app locally
# — with nothing set below, the backend boots in local/simulated blockchain
# mode and a demo JWT secret.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=*

# Path to the SQLite database file (created automatically).
DB_PATH=./data/green-wallet.db

# CHANGE THESE before any real deployment.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
KEY_ENCRYPTION_SECRET=replace-with-a-long-random-string

# Simulation
SIMULATION_ENABLED=true
SIMULATION_TICK_MS=5000
SIMULATION_MINUTES_PER_TICK=30

# --- Real Hedera testnet mode -----------------------------------------------
# Leave all three blank to stay in local/simulated blockchain mode (default,
# no external account needed). To enable real on-chain settlement:
#   1. Create a free testnet account at https://portal.hedera.com
#   2. Set HEDERA_OPERATOR_ID / HEDERA_OPERATOR_KEY below (ECDSA private key)
#   3. Run `npm run init:token` once to create the TEC token and get its id
#   4. Set HEDERA_TOKEN_ID to the id printed by that script, then restart
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOKEN_ID=
