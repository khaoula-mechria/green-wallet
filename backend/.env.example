# Copy to .env and adjust. None of these are required to run the app locally
# — with nothing set below, the backend boots in development mode with local/
# simulated blockchain, demo data, the simulation and a demo JWT secret.
#
# With NODE_ENV=production the backend REFUSES TO START unless JWT_SECRET and
# KEY_ENCRYPTION_SECRET are real secrets (>= 32 chars, distinct, not the
# placeholders below) and CORS_ORIGIN is not '*'. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=4000
# Unset: '*' in development, same-origin only in production.
# Otherwise '*' (development only) or a comma-separated list of origins.
CORS_ORIGIN=

# Path to the SQLite database file (created automatically).
DB_PATH=./data/green-wallet.db

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
KEY_ENCRYPTION_SECRET=replace-with-a-long-random-string

# --- Demo features (default: on in development, off in production) ----------
# Seed 5 producers + 5 consumers (password `password123`) into an empty DB.
SEED_DEMO_DATA=
# Generate simulated meter readings every tick.
SIMULATION_ENABLED=
SIMULATION_TICK_MS=5000
SIMULATION_MINUTES_PER_TICK=30

# --- Manual meter readings ---------------------------------------------------
# Self-reported readings are minted into TEC, so they're untrusted: disabled by
# default in production, and always capped and rate-limited per household.
MANUAL_MEASUREMENTS_ENABLED=
MEASUREMENT_MAX_KWH=50
MEASUREMENT_MIN_INTERVAL_MS=60000

# TEC granted server-side to newly registered consumers (default: 20 in
# development, 0 in production). Clients can never set their own balance.
SIGNUP_GRANT_TEC=

# --- Ledger maintenance ------------------------------------------------------
# Background loop: retries anchoring to Hedera and releases trades stuck in
# 'pending' (their reserved offer capacity is returned).
LEDGER_MAINTENANCE_INTERVAL_MS=5000
# Give up on anchoring an entry after this many attempts (marked 'failed').
LEDGER_ANCHOR_MAX_ATTEMPTS=10
PENDING_TRADE_TIMEOUT_MS=300000

# --- Real Hedera testnet mode -----------------------------------------------
# Leave all three blank to stay in local/simulated blockchain mode (default,
# no external account needed). To enable real on-chain settlement:
#   1. Create a free testnet account at https://portal.hedera.com
#   2. Set HEDERA_OPERATOR_ID / HEDERA_OPERATOR_KEY below (ECDSA private key)
#   3. Run `npm run init:token` once to create the TEC token and get its id
#   4. Set HEDERA_TOKEN_ID to the id printed by that script, then restart
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOKEN_ID=
