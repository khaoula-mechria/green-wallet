# Used by `docker compose` — copy to `.env` (next to docker-compose.yml).
# The stack runs with NODE_ENV=production, so the backend refuses to start
# without real secrets. Generate each one with, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Required: at least 32 characters each, and different from each other.
JWT_SECRET=
KEY_ENCRYPTION_SECRET=

# --- Demo mode --------------------------------------------------------------
# All off by default. Set to true only for a local demo — never on a real
# deployment (demo accounts share the public password `password123`, and
# manual readings are self-reported).
SEED_DEMO_DATA=false
SIMULATION_ENABLED=false
MANUAL_MEASUREMENTS_ENABLED=false
# Demo neighbours: marketplace listings/purchases and daily top-ups for empty wallets.
DEMO_MARKET_ACTIVITY=false
# TEC granted to each new prosumer and consumer by the treasury.
WELCOME_GRANT_TEC=10

# Operator console at /admin. Closed unless set; at least 12 characters.
OPERATOR_PASSWORD=

# Ignored: the app runs on a simulated Hedera-style ledger (see README).
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOKEN_ID=
